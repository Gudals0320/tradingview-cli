{
  "name": "tradingview-cli",
  "version": "2.3.2",
  "description": "Personal TradingView Desktop CLI with Pine development and repeatable experiments",
  "type": "module",
  "bin": {
    "tv": "src/cli/index.js"
  },
  "scripts": {
    "tv": "node src/cli/index.js",
    "lint": "eslint src/ tests/ examples/ scripts/",
    "test": "npm run test:unit",
    "test:unit": "node scripts/test-unit.mjs",
    "test:e2e": "npm run smoke:desktop",
    "test:all": "node --test tests/*.test.js",
    "test:network": "node scripts/test-unit.mjs --network",
    "smoke:desktop": "node scripts/smoke-workspaces-desktop.mjs",
    "smoke:protection": "node scripts/smoke-workspace-protection.mjs",
    "smoke:lifetime": "node scripts/smoke-workspace-lifetime.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gudals0320/tradingview-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Gudals0320/tradingview-cli/issues"
  },
  "homepage": "https://github.com/Gudals0320/tradingview-cli#readme",
  "license": "MIT",
  "dependencies": {
    "chrome-remote-interface": "^0.33.2"
  },
  "devDependencies": {
    "eslint": "^9.39.4"
  },
  "private": true
}
