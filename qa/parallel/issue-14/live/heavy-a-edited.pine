//@version=6
strategy("Codex I14 A 20261001", overlay=true, initial_capital=100000, commission_type=strategy.commission.percent, commission_value=0.05, slippage=1, pyramiding=0)
length = input.int(20, "Length", minval=2)
average = ta.sma(close, length)
accumulator = 0.0
for index = 1 to 500
    accumulator += math.sin(close + index) * math.cos(close - index)
endDate = timestamp("UTC", 2026, 9, 30, 0, 0)
if ta.crossover(close, average) and time < endDate
    strategy.entry("L", strategy.long)
if ta.crossunder(close, average) or time >= endDate
    strategy.close("L")
plot(average + accumulator / 500 * 0.01)
// Version reconciliation after reload
