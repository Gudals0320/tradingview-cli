//@version=6
strategy("CLI-QA Large Edit 20261001", overlay=true, initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1, pyramiding=0, commission_type=strategy.commission.percent, commission_value=0.05, slippage=1, max_labels_count=100)

// Development fixture: a complete research strategy, never a broker integration.
// Revision 1 uses fixed ATR brackets. Revision 2 will add lifecycle-aware exits.
// UTF-8 preservation: 한글 메모 / "quoted text" / path C:\QA\Pine.
// A commented strategy.entry is documentation, not another entry call.
string revision = "baseline-v1"

// 01. Operating window and direction controls.
string groupWindow = "01 Window"
bool allowLong = input.bool(true, "Allow long", group=groupWindow)
bool allowShort = input.bool(true, "Allow short", group=groupWindow)
bool useSession = input.bool(false, "Use session filter", group=groupWindow)
string activeSession = input.session("0000-2359", "Session", group=groupWindow)
int startTime = input.time(timestamp("01 Jan 2025 00:00 +0000"), "Start", group=groupWindow)
int endTime = input.time(timestamp("31 Dec 2027 23:59 +0000"), "End", group=groupWindow)
bool closeOutside = input.bool(true, "Close outside window", group=groupWindow)

// 02. Trend stack and higher-timeframe confirmation.
string groupTrend = "02 Trend"
int fastLength = input.int(12, "Fast EMA", minval=2, group=groupTrend)
int slowLength = input.int(36, "Slow EMA", minval=3, group=groupTrend)
int baseLength = input.int(100, "Baseline EMA", minval=10, group=groupTrend)
int slopeLength = input.int(3, "Slope lookback", minval=1, group=groupTrend)
bool useHigher = input.bool(false, "Require confirmed HTF trend", group=groupTrend)
string higherTimeframe = input.timeframe("60", "Higher timeframe", group=groupTrend)
int higherLength = input.int(50, "HTF EMA", minval=2, group=groupTrend)

// 03. Momentum, participation and volatility gates.
string groupSignal = "03 Signal"
int rsiLength = input.int(14, "RSI length", minval=2, group=groupSignal)
float longRsi = input.float(52, "Long RSI floor", minval=0, maxval=100, group=groupSignal)
float shortRsi = input.float(48, "Short RSI ceiling", minval=0, maxval=100, group=groupSignal)
int volumeLength = input.int(20, "Volume average", minval=2, group=groupSignal)
bool useVolume = input.bool(false, "Require volume ratio", group=groupSignal)
float minVolume = input.float(0.8, "Minimum volume ratio", minval=0, step=0.1, group=groupSignal)
int atrLength = input.int(14, "ATR length", minval=2, group=groupSignal)
float minAtrPercent = input.float(0.01, "Minimum ATR percent", minval=0, step=0.01, group=groupSignal)
float maxAtrPercent = input.float(5.0, "Maximum ATR percent", minval=0.1, step=0.1, group=groupSignal)
int minimumScore = input.int(3, "Minimum directional score", minval=1, maxval=4, group=groupSignal)

// 04. Position sizing and fixed exit geometry.
string groupRisk = "04 Risk"
float riskPercent = input.float(0.25, "Equity risk percent", minval=0.01, maxval=2, step=0.05, group=groupRisk)
float stopAtrMultiple = input.float(2.0, "Initial stop ATR", minval=0.5, step=0.25, group=groupRisk)
float targetR = input.float(2.5, "Target in initial R", minval=0.5, step=0.25, group=groupRisk)
float maxNotionalPercent = input.float(25, "Notional cap percent", minval=1, maxval=100, group=groupRisk)
float quantityStep = input.float(0.001, "Quantity increment", minval=0.000001, group=groupRisk)
float minimumQuantity = input.float(0.001, "Minimum quantity", minval=0.000001, group=groupRisk)

// 05. Diagnostics use bounded arrays and one persistent dashboard.
string groupDisplay = "05 Diagnostics"
int historyCapacity = input.int(64, "Recent trade samples", minval=4, maxval=256, group=groupDisplay)
bool showDashboard = input.bool(true, "Show dashboard", group=groupDisplay)
bool showStops = input.bool(true, "Show exit levels", group=groupDisplay)
bool showSignals = input.bool(true, "Show signal markers", group=groupDisplay)
bool showBackground = input.bool(false, "Shade eligible regime", group=groupDisplay)
bool emitLogs = input.bool(true, "Emit QA summary", group=groupDisplay)
bool emitTradeLogs = input.bool(false, "Emit every closed trade", group=groupDisplay)

// Pure helpers keep sizing and rendering decisions in one place.
f_divide(float numerator, float denominator, float fallback) =>
    not na(denominator) and denominator != 0 ? numerator / denominator : fallback

f_clamp(float value, float lower, float upper) =>
    math.max(lower, math.min(upper, value))

f_price(float value) =>
    na(value) ? "n/a" : str.tostring(value, format.mintick)

f_number(float value) =>
    na(value) ? "n/a" : str.tostring(value, "#.##")

f_bool(bool value) =>
    value ? "yes" : "no"

f_mean(array<float> values) =>
    array.size(values) > 0 ? array.avg(values) : na

f_winRate(array<float> values) =>
    float wins = 0
    int count = array.size(values)
    if count > 0
        for index = 0 to count - 1
            wins += array.get(values, index) > 0 ? 1 : 0
    count > 0 ? wins / count * 100 : na

f_pushBounded(array<float> values, float sample, int capacity) =>
    array.push(values, sample)
    if array.size(values) > capacity
        array.shift(values)
    array.size(values)

f_quantity(float equity, float distance, float price) =>
    float cashRisk = math.max(equity, 0) * riskPercent / 100
    float pointValue = math.max(syminfo.pointvalue, 0.000001)
    float riskQuantity = f_divide(cashRisk, distance * pointValue, 0)
    float capQuantity = f_divide(math.max(equity, 0) * maxNotionalPercent / 100, price * pointValue, 0)
    float rounded = math.floor(math.min(riskQuantity, capQuantity) / quantityStep) * quantityStep
    rounded >= minimumQuantity ? rounded : 0

f_row(table panel, int row, string key, string value, color valueColor) =>
    table.cell(panel, 0, row, key, text_color=color.silver, bgcolor=color.new(color.black, 15), text_size=size.small)
    table.cell(panel, 1, row, value, text_color=valueColor, bgcolor=color.new(color.black, 15), text_size=size.small)

// All rolling indicators are evaluated on every bar, outside conditional blocks.
float fastEma = ta.ema(close, fastLength)
float slowEma = ta.ema(close, slowLength)
float baseEma = ta.ema(close, baseLength)
float rsiValue = ta.rsi(close, rsiLength)
float averageVolume = ta.sma(volume, volumeLength)
float volumeRatio = f_divide(volume, averageVolume, 1)
float atrValue = ta.atr(atrLength)
float atrPercent = f_divide(atrValue * 100, close, 0)
float slope = fastEma - fastEma[slopeLength]
// Offset plus lookahead_on requests only the prior confirmed higher-timeframe value.
float higherEma = request.security(syminfo.tickerid, higherTimeframe, ta.ema(close, higherLength)[1], lookahead=barmerge.lookahead_on)
bool crossLong = ta.crossover(fastEma, slowEma)
bool crossShort = ta.crossunder(fastEma, slowEma)

// Explainable directional scores: structure, baseline, momentum, and slope.
int longScore = (fastEma > slowEma ? 1 : 0) + (close > baseEma ? 1 : 0)
longScore += (rsiValue >= longRsi ? 1 : 0) + (slope > 0 ? 1 : 0)
int shortScore = (fastEma < slowEma ? 1 : 0) + (close < baseEma ? 1 : 0)
shortScore += (rsiValue <= shortRsi ? 1 : 0) + (slope < 0 ? 1 : 0)
float directionalBalance = f_clamp((longScore - shortScore) / 4.0, -1, 1)

bool ready = not na(baseEma) and not na(atrValue) and not na(slope)
bool inDates = time >= startTime and time <= endTime
bool inSession = not useSession or not na(time(timeframe.period, activeSession))
bool volumeAllowed = not useVolume or volumeRatio >= minVolume
bool volatilityAllowed = atrPercent >= minAtrPercent and atrPercent <= maxAtrPercent
bool higherLong = not useHigher or close > higherEma
bool higherShort = not useHigher or close < higherEma
bool executionWindow = ready and inDates and inSession and barstate.isconfirmed
bool commonGate = executionWindow and volumeAllowed and volatilityAllowed

// Durable trade state: initial risk never changes after an entry fill.
var float initialRisk = na
var float stopPrice = na
var float targetPrice = na
var float highSinceEntry = na
var float lowSinceEntry = na
var int entryBar = na
var int processedTrades = 0
var int longSignals = 0
var int shortSignals = 0
var int rejectedSignals = 0
var array<float> recentProfit = array.new_float(0)
var array<float> recentDuration = array.new_float(0)
var array<float> recentExcursion = array.new_float(0)

// Capture all newly closed trades once, including more than one in a recalculation.
if strategy.closedtrades > processedTrades
    for tradeIndex = processedTrades to strategy.closedtrades - 1
        float pnl = strategy.closedtrades.profit(tradeIndex)
        float barsHeld = strategy.closedtrades.exit_bar_index(tradeIndex) - strategy.closedtrades.entry_bar_index(tradeIndex)
        float excursion = strategy.closedtrades.max_runup(tradeIndex)
        f_pushBounded(recentProfit, pnl, historyCapacity)
        f_pushBounded(recentDuration, barsHeld, historyCapacity)
        f_pushBounded(recentExcursion, excursion, historyCapacity)
        if emitTradeLogs
            log.info("QA trade {0}: pnl={1}, bars={2}", tradeIndex, pnl, barsHeld)
    processedTrades := strategy.closedtrades

bool flat = strategy.position_size == 0
bool freshLong = strategy.position_size > 0 and strategy.position_size[1] <= 0
bool freshShort = strategy.position_size < 0 and strategy.position_size[1] >= 0
bool longSignal = commonGate and allowLong and higherLong and crossLong and longScore >= minimumScore
bool shortSignal = commonGate and allowShort and higherShort and crossShort and shortScore >= minimumScore
float plannedRisk = math.max(atrValue * stopAtrMultiple, syminfo.mintick)
float plannedQuantity = f_quantity(strategy.equity, plannedRisk, close)

if flat and executionWindow and (crossLong or crossShort) and not (longSignal or shortSignal)
    rejectedSignals += 1

if flat and longSignal and plannedQuantity > 0
    initialRisk := plannedRisk
    strategy.entry("Long", strategy.long, qty=plannedQuantity, comment="score long")
    longSignals += 1

if flat and shortSignal and plannedQuantity > 0
    initialRisk := plannedRisk
    strategy.entry("Short", strategy.short, qty=plannedQuantity, comment="score short")
    shortSignals += 1

// Fill-relative bracket levels avoid using the pre-fill close as entry price.
if freshLong or freshShort
    entryBar := bar_index
    highSinceEntry := high
    lowSinceEntry := low
    initialRisk := nz(initialRisk, plannedRisk)
    if freshLong
        stopPrice := strategy.position_avg_price - initialRisk
        targetPrice := strategy.position_avg_price + initialRisk * targetR
    else
        stopPrice := strategy.position_avg_price + initialRisk
        targetPrice := strategy.position_avg_price - initialRisk * targetR

// Baseline exit policy: keep initial ATR stop and target fixed until flat.
if strategy.position_size > 0
    highSinceEntry := math.max(nz(highSinceEntry, high), high)
    strategy.exit("Long bracket", from_entry="Long", stop=stopPrice, limit=targetPrice)

if strategy.position_size < 0
    lowSinceEntry := math.min(nz(lowSinceEntry, low), low)
    strategy.exit("Short bracket", from_entry="Short", stop=stopPrice, limit=targetPrice)

if closeOutside and not inDates and not flat
    strategy.close_all(comment="window ended")

if flat and not (longSignal or shortSignal)
    stopPrice := na
    targetPrice := na
    highSinceEntry := na
    lowSinceEntry := na
    entryBar := na

// Bounded telemetry is separate from order generation.
float sampleWinRate = f_winRate(recentProfit)
float meanProfit = f_mean(recentProfit)
float meanDuration = f_mean(recentDuration)
float meanExcursion = f_mean(recentExcursion)
int positionBars = na(entryBar) ? 0 : bar_index - entryBar
string positionName = flat ? "flat" : strategy.position_size > 0 ? "long" : "short"
color directionColor = directionalBalance >= 0 ? color.teal : color.orange
color statusColor = commonGate ? color.lime : color.silver

// Chart overlays show both signals and the currently active bracket.
fastPlot = plot(fastEma, "Fast EMA", color=color.teal)
slowPlot = plot(slowEma, "Slow EMA", color=color.orange)
plot(baseEma, "Baseline EMA", color=color.gray, linewidth=2)
plot(useHigher ? higherEma : na, "Confirmed HTF EMA", color=color.purple)
fill(fastPlot, slowPlot, color=color.new(directionColor, 92), title="Trend spread")
plot(showStops and not flat ? stopPrice : na, "Active stop", color=color.red, style=plot.style_linebr)
plot(showStops and not flat ? targetPrice : na, "Target", color=color.green, style=plot.style_linebr)
plotshape(showSignals and longSignal, title="Long setup", style=shape.triangleup, location=location.belowbar, color=color.teal, size=size.tiny)
plotshape(showSignals and shortSignal, title="Short setup", style=shape.triangledown, location=location.abovebar, color=color.orange, size=size.tiny)
bgcolor(showBackground and commonGate ? color.new(directionColor, 94) : na, title="Eligible regime")

// One table, updated only on the last bar; no unbounded drawing allocation.
var table dashboard = table.new(position.top_right, 2, 16, border_width=1)
if barstate.islast and showDashboard
    f_row(dashboard, 0, "CLI-QA revision", revision, color.white)
    f_row(dashboard, 1, "Long / short score", str.tostring(longScore) + " / " + str.tostring(shortScore), directionColor)
    f_row(dashboard, 2, "Window / filters", f_bool(executionWindow) + " / " + f_bool(commonGate), statusColor)
    f_row(dashboard, 3, "ATR percent", f_number(atrPercent), color.white)
    f_row(dashboard, 4, "Volume ratio", f_number(volumeRatio), color.white)
    f_row(dashboard, 5, "Position", positionName, directionColor)
    f_row(dashboard, 6, "Stop / target", f_price(stopPrice) + " / " + f_price(targetPrice), color.white)
    f_row(dashboard, 7, "Bars held", str.tostring(positionBars), color.white)
    f_row(dashboard, 8, "Recent samples", str.tostring(array.size(recentProfit)), color.white)
    f_row(dashboard, 9, "Recent win percent", f_number(sampleWinRate), color.white)
    f_row(dashboard, 10, "Mean profit", f_number(meanProfit), color.white)
    f_row(dashboard, 11, "Mean duration", f_number(meanDuration), color.white)
    f_row(dashboard, 12, "Mean excursion", f_number(meanExcursion), color.white)
    f_row(dashboard, 13, "Long / short signals", str.tostring(longSignals) + " / " + str.tostring(shortSignals), color.white)
    f_row(dashboard, 14, "Rejected setups", str.tostring(rejectedSignals), color.white)
    f_row(dashboard, 15, "Closed trades", str.tostring(strategy.closedtrades), color.white)

// A unique summary marker makes runtime output distinguishable from source text.
if barstate.islastconfirmedhistory and emitLogs
    log.info("QA-LARGE-BASELINE revision={0}; trades={1}; samples={2}; window={3}", revision, strategy.closedtrades, array.size(recentProfit), executionWindow)
    log.info("QA-LARGE-METRICS win={0}; duration={1}; excursion={2}", sampleWinRate, meanDuration, meanExcursion)
