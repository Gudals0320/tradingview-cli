//@version=6
indicator("CLI-QA-S01 MTF Trend 20261001", shorttitle = "S01 MTF", overlay = true)

// Current-timeframe EMA cross signals, filtered by the LAST CONFIRMED higher-timeframe trend.
fastLen = input.int(12, "Fast EMA", minval = 1)
slowLen = input.int(36, "Slow EMA", minval = 1)
htfTf = input.timeframe("60", "HTF timeframe")
htfLen = input.int(50, "HTF EMA", minval = 1)
useFilter = input.bool(true, "HTF filter ON")

emaFast = ta.ema(close, fastLen)
emaSlow = ta.ema(close, slowLen)
bullCross = ta.crossover(emaFast, emaSlow)
bearCross = ta.crossunder(emaFast, emaSlow)
rawCross = bullCross ? 1 : bearCross ? -1 : 0

// Non-repainting HTF request: [1] + lookahead_on returns the previous, fully closed HTF bar
// on both historical and realtime bars.
htfEmaSeries() => ta.ema(close, htfLen)
[htfClose, htfEma, htfOpenTime, htfCloseTime] = request.security(syminfo.tickerid, htfTf, [close[1], htfEmaSeries()[1], time[1], time_close[1]], lookahead = barmerge.lookahead_on)
htfTrend = na(htfEma) ? 0 : htfClose > htfEma ? 1 : htfClose < htfEma ? -1 : 0

bullPass = bullCross and (not useFilter or htfTrend == 1)
bearPass = bearCross and (not useFilter or htfTrend == -1)
excluded = rawCross != 0 and not bullPass and not bearPass

var int bullPassCount = 0
var int bearPassCount = 0
var int excludedCount = 0
bullPassCount += bullPass ? 1 : 0
bearPassCount += bearPass ? 1 : 0
excludedCount += excluded ? 1 : 0

plot(emaFast, "EMA Fast", color.teal)
plot(emaSlow, "EMA Slow", color.orange)
plotshape(bullPass, "Bull pass", shape.triangleup, location.belowbar, color.green, size = size.small)
plotshape(bearPass, "Bear pass", shape.triangledown, location.abovebar, color.red, size = size.small)
plotshape(excluded, "Excluded", shape.xcross, location.abovebar, color.gray, size = size.tiny)

// Comparison / verification plots (data window only).
plot(rawCross, "rawCross", display = display.data_window)
plot(htfTrend, "htfTrend", display = display.data_window)
plot(htfClose, "htfClose", display = display.data_window)
plot(htfEma, "htfEma", display = display.data_window)
plot(htfOpenTime, "htfOpenTime", display = display.data_window)
plot(htfCloseTime, "htfCloseTime", display = display.data_window)
plot(bullPass ? 1 : bearPass ? -1 : 0, "passCode", display = display.data_window)
plot(excluded ? rawCross : 0, "excludedCode", display = display.data_window)

var table dash = table.new(position.top_right, 2, 8, bgcolor = color.new(color.black, 20), border_width = 1)
if barstate.islast
    trendText = htfTrend == 1 ? "UP" : htfTrend == -1 ? "DOWN" : "FLAT"
    table.cell(dash, 0, 0, "HTF", text_color = color.white)
    table.cell(dash, 1, 0, htfTf, text_color = color.white)
    table.cell(dash, 0, 1, "HTF bar (confirmed)", text_color = color.white)
    table.cell(dash, 1, 1, str.format_time(int(htfOpenTime), "yyyy-MM-dd HH:mm", "UTC"), text_color = color.white)
    table.cell(dash, 0, 2, "HTF close", text_color = color.white)
    table.cell(dash, 1, 2, str.tostring(htfClose, format.mintick), text_color = color.white)
    table.cell(dash, 0, 3, "HTF EMA" + str.tostring(htfLen), text_color = color.white)
    table.cell(dash, 1, 3, str.tostring(htfEma, format.mintick), text_color = color.white)
    table.cell(dash, 0, 4, "Trend", text_color = color.white)
    table.cell(dash, 1, 4, trendText, text_color = color.white)
    table.cell(dash, 0, 5, "Filter", text_color = color.white)
    table.cell(dash, 1, 5, useFilter ? "ON" : "OFF", text_color = color.white)
    table.cell(dash, 0, 6, "Pass bull/bear", text_color = color.white)
    table.cell(dash, 1, 6, str.tostring(bullPassCount) + "/" + str.tostring(bearPassCount), text_color = color.white)
    table.cell(dash, 0, 7, "Excluded", text_color = color.white)
    table.cell(dash, 1, 7, str.tostring(excludedCount), text_color = color.white)
