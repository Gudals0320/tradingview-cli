//@version=6
// CLI-QA-S05 library contract fixture, signature edit: weighted_score gains a `scale` argument.
// Disposable QA asset; never published.
// @description Ordered math helpers with explicit edge policies: clamp, normalize, weighted score, array mean and population variance.
// NOTE: a library title may not contain spaces (Desktop compiler rule); pine check does not flag it.
library("CLIQAS05MathLib20261001")

// Edge policies
//   clamp          : bounds are ordered internally; the result always lies inside [min(lo,hi), max(lo,hi)].
//   normalize      : a zero-width domain (hi == lo) returns `fallback`; out-of-range inputs are NOT clamped.
//   weighted_score : empty inputs, a length mismatch or a zero weight sum return `fallback`; `scale` multiplies the weighted average.
//   array_mean     : an empty array returns `fallback`.
//   array_variance : an empty array returns `fallback`; the variance is the population variance (divide by n).

// >>> CLIQAS05-BODY-BEGIN
export clamp(float value, float lo, float hi) =>
    float lower = math.min(lo, hi)
    float upper = math.max(lo, hi)
    math.max(lower, math.min(upper, value))

export normalize(float value, float lo, float hi, float fallback = 0.0) =>
    float span = hi - lo
    float result = fallback
    if span != 0.0
        result := (value - lo) / span
    result

export weighted_score(array<float> values, array<float> weights, float fallback = 0.0, float scale = 1.0) =>
    float result = fallback
    int count = array.size(values)
    if count > 0 and array.size(weights) == count
        float weightSum = 0.0
        float weightedSum = 0.0
        for i = 0 to count - 1
            float weight = array.get(weights, i)
            weightSum += weight
            weightedSum += array.get(values, i) * weight
        if weightSum != 0.0
            result := weightedSum / weightSum * scale
    result

export array_mean(array<float> values, float fallback = 0.0) =>
    float result = fallback
    int count = array.size(values)
    if count > 0
        float total = 0.0
        for i = 0 to count - 1
            total += array.get(values, i)
        result := total / count
    result

export array_variance(array<float> values, float fallback = 0.0) =>
    float result = fallback
    int count = array.size(values)
    if count > 0
        float total = 0.0
        for i = 0 to count - 1
            total += array.get(values, i)
        float avg = total / count
        float acc = 0.0
        for i = 0 to count - 1
            float diff = array.get(values, i) - avg
            acc += diff * diff
        result := acc / count
    result
// <<< CLIQAS05-BODY-END
