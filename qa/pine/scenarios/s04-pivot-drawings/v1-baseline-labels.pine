//@version=6
indicator("CLI-QA-S04 Pivot Zones", "S04PZ", overlay = true, max_labels_count = 500)

// S04 v1 baseline: label each confirmed pivot (pivot bar = confirm bar - rightLen).
leftLen  = input.int(5, "Pivot left bars", minval = 1)
rightLen = input.int(5, "Pivot right bars", minval = 1)

ph = ta.pivothigh(high, leftLen, rightLen)
pl = ta.pivotlow(low, leftLen, rightLen)

var int nPH = 0
var int nPL = 0

if barstate.isconfirmed
    if not na(ph)
        nPH += 1
        label.new(bar_index - rightLen, ph, "PH " + str.tostring(ph, format.mintick), style = label.style_label_down, color = color.red, textcolor = color.white)
    if not na(pl)
        nPL += 1
        label.new(bar_index - rightLen, pl, "PL " + str.tostring(pl, format.mintick), style = label.style_label_up, color = color.teal, textcolor = color.white)

var table diag = table.new(position.top_right, 2, 4, bgcolor = color.new(color.black, 20))
if barstate.islast
    table.cell(diag, 0, 0, "S04 v1", text_color = color.white)
    table.cell(diag, 1, 0, "labels", text_color = color.white)
    table.cell(diag, 0, 1, "pivotHighs", text_color = color.white)
    table.cell(diag, 1, 1, str.tostring(nPH), text_color = color.white)
    table.cell(diag, 0, 2, "pivotLows", text_color = color.white)
    table.cell(diag, 1, 2, str.tostring(nPL), text_color = color.white)
    table.cell(diag, 0, 3, "labelAll", text_color = color.white)
    table.cell(diag, 1, 3, str.tostring(array.size(label.all)), text_color = color.white)
